$block-caption
  text-decoration: none
  text-transform: uppercase
  letter-spacing: 2px
  color: color-grey
  margin-bottom: 1em
  margin-left: 5px
  line-height: 1em
  text-shadow: 0 1px #fff
  font-weight: bold

$block
  background: #fff
  box-shadow: 1px 2px 3px #ddd
  border: 1px solid color-border
  border-radius: 3px

$base-style
  h1
    font-size: 2em
  h2
    font-size: 1.5em
  h3
    font-size: 1.3em
  h4
    font-size: 1.2em
  h5
    font-size: 1em
  h6
    font-size: 1em
    color: color-grey
  hr
    border: 1px dashed color-border
  strong
    font-weight: bold
  em, cite
    font-style: italic
  sup, sub
    font-size: 0.75em
    line-height: 0
    position: relative
    vertical-align: baseline
  sup
    top: -0.5em
  sub
    bottom: -0.2em
  small
    font-size: 0.85em
  acronym, abbr
    border-bottom: 1px dotted
  ul, ol, dl
    margin: 0 20px
    line-height: line-height
  ul, ol
    ul, ol
      margin-top: 0
      margin-bottom: 0
  ul
    list-style: disc
  ol
    list-style: decimal
  dt
    font-weight: bold

/* ========== Dejavu UI 玻璃拟态覆盖 ========== */

:root {
  --dj-bg: #eef1f4;
  --dj-blob-1: rgba(160, 205, 193, .50);
  --dj-blob-2: rgba(168, 190, 220, .45);
  --dj-blob-3: rgba(228, 205, 175, .42);
  --dj-ink: #333d47;
  --dj-accent: #3e7d74;
  --dj-accent-2: #a8794e;
  --dj-accent-soft: rgba(62, 125, 116, .12);
  --dj-glass: rgba(255, 255, 255, .65);
  --dj-glass-strong: rgba(255, 255, 255, .85);
  --dj-line: rgba(51, 61, 71, .1);
  --dj-blur: 16px;
}

body {
  background: radial-gradient(1100px 760px at 12% -8%, var(--dj-blob-1) 0%, transparent 56%),
    radial-gradient(980px 700px at 102% 4%, var(--dj-blob-2) 0%, transparent 52%),
    radial-gradient(1150px 900px at 50% 118%, var(--dj-blob-3) 0%, transparent 56%),
    var(--dj-bg) !important;
  background-attachment: fixed !important;
  color: var(--dj-ink);
}

#wrap {
  background: transparent !important;
}

#banner {
  display: none !important;
}

#header {
  background: var(--dj-glass-strong) !important;
  -webkit-backdrop-filter: blur(var(--dj-blur)) saturate(1.5) !important;
  backdrop-filter: blur(var(--dj-blur)) saturate(1.5) !important;
  border-bottom: 1px solid var(--dj-line) !important;
  position: sticky;
  top: 0;
  z-index: 200;
}

#header-outer {
  height: auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  padding: 12px 20px;
}

#logo {
  font-size: 22px;
  font-weight: 700;
  letter-spacing: 1px;
  color: var(--dj-ink) !important;
}

#subtitle-wrap {
  display: none;
}

#main-nav {
  display: flex;
  align-items: center;
  gap: 6px;
}

.main-nav-link {
  color: var(--dj-ink) !important;
  padding: 8px 14px !important;
  border-radius: 999px;
}

.main-nav-link:hover {
  background: var(--dj-accent-soft);
  color: var(--dj-accent) !important;
}

article.article {
  background: var(--dj-glass) !important;
  -webkit-backdrop-filter: blur(var(--dj-blur)) saturate(1.4) !important;
  backdrop-filter: blur(var(--dj-blur)) saturate(1.4) !important;
  border: 1px solid var(--dj-line) !important;
  border-radius: 22px !important;
  box-shadow: 0 10px 28px -14px rgba(28, 42, 52, .16) !important;
  overflow: hidden !important;
  margin: 22px 0;
}

.article-inner {
  background: transparent !important;
  box-shadow: none !important;
  border: none !important;
}

.article-entry h2 {
  padding-left: 14px;
  position: relative;
}

.article-entry h2::before {
  content: "";
  position: absolute;
  left: 0;
  top: .16em;
  bottom: .16em;
  width: 4px;
  border-radius: 4px;
  background: linear-gradient(180deg, var(--dj-accent), var(--dj-accent-2));
}

.article-entry a {
  color: var(--dj-accent);
  text-decoration: none;
}

.article-entry blockquote {
  border-left: 4px solid var(--dj-accent);
  background: var(--dj-accent-soft);
  border-radius: 12px;
  padding: 14px 20px;
  margin: 1.4em 0;
}

.article-entry code {
  background: var(--dj-accent-soft);
  color: var(--dj-accent);
  padding: 2px 6px;
  border-radius: 6px;
}

.article-entry pre {
  border: 1px solid var(--dj-line);
  border-radius: 12px;
  padding: 16px 18px;
}

.article-more-link a {
  display: inline-block;
  padding: 8px 18px;
  border-radius: 999px;
  background: var(--dj-accent-soft);
  color: var(--dj-accent);
}

#sidebar .widget-wrap {
  background: var(--dj-glass) !important;
  -webkit-backdrop-filter: blur(var(--dj-blur)) saturate(1.4) !important;
  backdrop-filter: blur(var(--dj-blur)) saturate(1.4) !important;
  border: 1px solid var(--dj-line) !important;
  border-radius: 16px !important;
  padding: 18px 20px;
  margin-bottom: 20px;
}

#sidebar .widget {
  background: transparent;
  border: none;
  box-shadow: none;
}

#sidebar .widget-title {
  color: var(--dj-ink);
  font-weight: 600;
}

#page-nav .page-number {
  background: var(--dj-glass);
  border: 1px solid var(--dj-line);
  border-radius: 12px;
  color: var(--dj-ink);
}

#page-nav .page-number.current {
  background: var(--dj-accent);
  border-color: var(--dj-accent);
  color: #fff;
}
